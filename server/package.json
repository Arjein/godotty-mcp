{
  "name": "godotty-mcp",
  "version": "0.0.0",
  "private": true,
  "description": "MCP server that lets AI agents edit, run, see and play-test Godot 4 projects.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "godotty-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fast-xml-parser": "^5.12.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^5.1.1",
    "typescript": "~6.0",
    "vitest": "^5.1.1"
  }
}
